{
  "name": "bpi-ts",
  "version": "0.1.0",
  "description": "Typed Node.js SDK for the Bilibili HTTP API, ported from bpi-go",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } },
    "./*": { "import": { "types": "./dist/*/index.d.ts", "default": "./dist/*/index.js" }, "require": { "types": "./dist/*/index.d.cts", "default": "./dist/*/index.cjs" } },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsup && node scripts/build-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run build"
  },
  "keywords": ["bilibili", "api", "sdk", "typescript", "wbi"],
  "license": "MIT",
  "devDependencies": { "@types/node": "^22.19.0", "tsup": "^8.5.1", "typescript": "^5.9.3", "vitest": "^5.0.3" },
  "overrides": { "esbuild": "^0.28.2" }
}
